# Origem HTTPS canônica (somente domínio, sem caminho); necessária para canonical, sitemap e previews sociais.
# Deixe vazia até confirmar o domínio definitivo.
VITE_SITE_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=
# Use / para hospedagem na raiz (TurboSite); vazio mantém o base path atual do GitHub Pages.
VITE_BASE_PATH=
# Configure /api/contact.php na compilação de produção após publicar o endpoint PHP.
VITE_CONTACT_ENDPOINT=
